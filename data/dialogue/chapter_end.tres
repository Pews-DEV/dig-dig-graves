[resource]
script = ExtResource("1_dialogue")
id = &"chapter_end"
lines = Array[Dictionary]([{
"name": "Dona Ceifa",
"speaker": &"ceifa",
"text": "O primeiro campo está em paz. Obrigada por cuidar destas covas."
}, {
"name": "Coveiro",
"speaker": &"coveiro",
"text": "Vou continuar cavando. Ainda há raízes que precisam de mim."
}])
