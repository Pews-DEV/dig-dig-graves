id = &"unrest_full"
lines = Array[Dictionary]([{
"name": "Dona Ceifa",
"speaker": &"ceifa",
"text": "A terra está tremendo. O Caixão Fujão despertou lá embaixo."
}, {
"name": "Tião",
"speaker": &"tiao",
"text": "Quando estiver pronto, aperte Enfrentar. A gente espera aqui."
}])
